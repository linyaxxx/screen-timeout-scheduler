<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="Surface" Background="#F5F7F5" BorderBrush="#DAE2DC" BorderThickness="1" CornerRadius="14"
        SnapsToDevicePixels="True" TextElement.Foreground="#20372B" TextElement.FontSize="13">
  <Border.Resources>
    <SolidColorBrush x:Key="Accent" Color="#286448"/>
    <SolidColorBrush x:Key="Muted" Color="#69776E"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#34483C"/>
      <Setter Property="BorderBrush" Value="#DCE4DE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.60"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#286448"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#286448"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#286448"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="#F0F4F1"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#20372B"/>
      <Setter Property="BorderBrush" Value="#DCE4DE"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/><Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#AAD2BA"/><Setter Property="CaretBrush" Value="#286448"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#286448"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#8AAE96"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Day" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#F3F5F3"/><Setter Property="Foreground" Value="#69776E"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="#E5F0E8"/><Setter Property="Foreground" Value="#286448"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#8AAE96"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#286448"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="26"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Background="#D5DED7" CornerRadius="13" BorderThickness="1" BorderBrush="Transparent">
            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#286448"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#20372B"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="22,0,14,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#286448" CornerRadius="7" Width="27" Height="27">
          <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="屏幕省电时段" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource IconButton}" Background="Transparent" ToolTip="收起到托盘" Margin="0,0,4,0"/>
        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource IconButton}" Background="Transparent" ToolTip="关闭窗口，继续在托盘运行"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Margin="28,10,28,0">
      <TextBlock Text="屏幕休息，也有时间表。" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="工作时多一点耐心，离开后少一点耗电。" Foreground="{StaticResource Muted}" Margin="0,9,0,0" FontSize="13"/>
    </StackPanel>
    <Grid Grid.Row="2" Margin="28,0,28,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="294"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#183F30" CornerRadius="16" Padding="22">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="当前状态" Foreground="#C6DCCE" FontSize="12" VerticalAlignment="Center"/>
              <Border x:Name="StatusBadge" Background="#305342" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" Text="待启用" Foreground="#E7F2EA" FontSize="11"/>
              </Border>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
              <TextBlock x:Name="ModeText" Text="当前时段规则" Foreground="#C6DCCE" FontSize="12" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CurrentMinutes" Text="15" Foreground="White" FontFamily="Segoe UI" FontSize="62" FontWeight="SemiBold" LineHeight="76"/>
                <TextBlock x:Name="CurrentUnit" Text="分钟" Foreground="#D1E6D8" FontSize="15" VerticalAlignment="Bottom" Margin="8,0,0,13"/>
              </StackPanel>
              <TextBlock x:Name="StateDescription" Text="保存并启用后，按此规则自动关屏" Foreground="#D1E6D8" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="#426250" BorderThickness="0,1,0,0" Padding="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="NextCaption" Text="下一时段 · 规则预览" Foreground="#A8C7B4" FontSize="11"/>
                <TextBlock x:Name="NextText" Text="12:00 → 1 分钟" Foreground="#F2F8F4" FontSize="14" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="2,24,2,0">
          <TextBlock Text="今天的时间表" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="TimelineCaption" Text="已选时段预览" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14"/>
          <Canvas x:Name="Timeline" Height="36" ClipToBounds="True"/>
          <Grid Margin="0,0,0,16">
            <TextBlock Text="00:00" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock Text="12:00" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11"/>
            <TextBlock Text="24:00" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontFamily="Segoe UI" FontSize="11"/>
          </Grid>
          <Grid>
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#448F63" Margin="0,0,7,0"/><TextBlock x:Name="WorkLegend" Text="工作 15 分钟" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="7" Height="7" Fill="#DCE5DE" Margin="0,0,7,0"/><TextBlock x:Name="OtherLegend" Text="其余 1 分钟" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
          </Grid>
        </StackPanel>
      </Grid>
      <Border Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#E4EAE5" BorderThickness="1" Padding="24,21">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid>
              <TextBlock Text="工作时段" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button x:Name="AddPeriodButton" Content="＋ 添加时段" HorizontalAlignment="Right" BorderThickness="0" Foreground="#286448" Background="#EDF5EF" Padding="10,6" MinHeight="30" FontSize="12"/>
            </Grid>
            <UniformGrid x:Name="Weekdays" Columns="7" Margin="0,14,-6,13"/>
            <ScrollViewer x:Name="PeriodScroll" Height="114" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="PeriodRows"/>
            </ScrollViewer>
            <TextBlock Text="24 小时制；结束早于开始，表示跨到次日。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,16"/>
            <TextBlock Text="关闭屏幕前等待" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#F4F7F4" CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="工作时段" FontSize="12" Foreground="#536A5B"/>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkMinutesInput" Text="15" FontSize="26" FontWeight="SemiBold" Padding="9,2" Height="43" MaxLength="4" ToolTip="工作时段等待分钟数，1–1440"/>
                    <TextBlock Grid.Column="1" Text="分钟" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="#69776E"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#F4F7F4" CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <TextBlock Text="其余时间" FontSize="12" Foreground="#536A5B"/>
                  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OtherMinutesInput" Text="1" FontSize="26" FontWeight="SemiBold" Padding="9,2" Height="43" MaxLength="4" ToolTip="其余时间等待分钟数，1–1440"/>
                    <TextBlock Grid.Column="1" Text="分钟" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="#69776E"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
            <Border BorderBrush="#E7ECE8" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
              <Grid>
                <StackPanel Margin="0,0,54,0"><TextBlock Text="登录后自动启动" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="每次登录 Windows，自动运行已保存的规则" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="登录 Windows 后自动启动"/>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="3" Margin="28,0,28,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock x:Name="Feedback" Text="插电和电池都适用" FontSize="12" Foreground="#536A5B" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="FooterNote" Text="关闭窗口后，仍在托盘运行" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PauseButton" Content="暂停并恢复" Width="130" Height="42" Margin="0,0,12,0" ToolTip="暂停自动切换，并恢复接管前的关屏设置"/>
        <Button x:Name="SaveButton" Content="保存并启用" Style="{StaticResource Primary}" Width="150" Height="42"/>
      </StackPanel>
    </Grid>
  </Grid>
</Border>
